<?php

/**
 * @file
 * Install, update and uninstall functions for custom_general_features module.
 */

use Drupal\Core\Entity\ContentEntityInterface;

/**
 * Remove all Galician (gl) translations from content entities.
 *
 * Affected entity types: node, paragraph, taxonomy_term, menu_link_content,
 * path_alias.
 */

function custom_general_features_update_11001(&$sandbox): string {
  $lang = 'gl';
  $db = \Drupal::database();

  // Initialise the sandbox on the first run.
  if (!isset($sandbox['total'])) {
    $sandbox['entity_types'] = [
      'node' => [
        'table' => 'node_field_data',
        'id_col' => 'nid',
      ],
      'paragraph' => [
        'table' => 'paragraphs_item_field_data',
        'id_col' => 'id',
      ],
      'taxonomy_term' => [
        'table' => 'taxonomy_term_field_data',
        'id_col' => 'tid',
      ],
      'menu_link_content' => [
        'table' => 'menu_link_content_data',
        'id_col' => 'id',
      ],
      'path_alias' => [
        'table' => 'path_alias',
        'id_col' => 'id',
      ],
    ];

    // Count total entities to process across all types.
    $sandbox['total'] = 0;
    foreach ($sandbox['entity_types'] as $info) {
      $sandbox['total'] += (int) $db->select($info['table'], 't')
        ->fields('t', [$info['id_col']])
        ->condition('t.langcode', $lang)
        ->distinct()
        ->countQuery()
        ->execute()
        ->fetchField();
    }

    $sandbox['processed'] = 0;
    $sandbox['current_type_index'] = 0;
    $sandbox['messages'] = [];

    if ($sandbox['total'] === 0) {
      $sandbox['#finished'] = 1;
      return 'No Galician translations found. Nothing to do.';
    }
  }

  $batch_size = 25;
  $entity_type_ids = array_keys($sandbox['entity_types']);

  $entity_type_id = $entity_type_ids[$sandbox['current_type_index']];
  $info = $sandbox['entity_types'][$entity_type_id];

  $ids = $db->select($info['table'], 't')
    ->fields('t', [$info['id_col']])
    ->condition('t.langcode', $lang)
    ->distinct()
    ->range(0, $batch_size)
    ->execute()
    ->fetchCol();

  if (empty($ids)) {
    $sandbox['messages'][] = "Finished $entity_type_id.";
    $sandbox['current_type_index']++;
  }
  else {
    $storage = \Drupal::entityTypeManager()->getStorage($entity_type_id);
    $entities = $storage->loadMultiple($ids);

    foreach ($ids as $id) {
      $entity = $entities[$id] ?? NULL;

      if (!$entity instanceof ContentEntityInterface) {
        \Drupal::logger('custom_general_features')->warning('Could not load @type entity @id, skipping.', [
          '@type' => $entity_type_id,
          '@id' => $id,
        ]);
        $sandbox['processed']++;
        continue;
      }

      if ($entity_type_id === 'path_alias') {
        // Path aliases store langcode as a direct field, not via Drupal's
        // translation API, so hasTranslation() does not apply. Delete directly.
        $entity->delete();
      }
      elseif ($entity->hasTranslation($lang)) {
        if ($entity->getUntranslated()->language()->getId() === $lang) {
          $entity->delete();
        }
        else {
          $entity->removeTranslation($lang);
          $entity->save();
        }
      }

      $sandbox['processed']++;
    }
  }

  // Finished when all entity types have been exhausted.
  $sandbox['#finished'] = ($sandbox['current_type_index'] >= count($entity_type_ids)) ? 1 : 0;

  if ($sandbox['#finished'] >= 1) {
    return sprintf(
      'Removed Galician (gl) translations from %d entities (%s).',
      $sandbox['processed'],
      implode(', ', $sandbox['messages'])
    );
  }

  return sprintf(
    'Removing Galician translations: processing %s (%d done so far).',
    $entity_type_id,
    $sandbox['processed']
  );
}

/**
 * Update "Selection criteria for talks" (node 3) for Drupal Dev Days 2027.
 *
 * Values marked as [TBD] are pending decisions from the organization.
 */
function custom_general_features_update_11002(): string {
  $bodies = [
    'en' => <<<'HTML'
<blockquote><p class="p--text-bigger">SESSION SUBMISSION DEADLINE: [TBD: Month DD, 2027]</p></blockquote>
<p><strong>The selection criteria are based on the following parameters:</strong></p>
<p><strong>DRUPAL VERSION</strong><br>Priority will be given to topics related to current versions of Drupal: Drupal 11, Drupal 12 and Drupal CMS. Sessions about older versions will only be considered if they focus on upgrades or migrations.</p>
<p><strong>PROPOSED TOPICS</strong></p>
<ul class="ul--pills--inline"><li>Development</li><li>Testing</li><li>DevOps / Infrastructure</li><li>Front-end / Theming</li><li>Site Building</li><li>Drupal CMS / Recipes</li><li>AI</li><li>Accessibility</li><li>Performance</li><li>Contribution / Mentoring</li><li>Project management / Work methodologies</li><li>Business</li><li>Others</li></ul>
<p><strong>LANGUAGE</strong><br>Drupal Developer Days is an international event, so all sessions must be presented in English.</p>
<p><strong>REQUIRED KNOWLEDGE</strong><br>For each session, we will consider whether it is aimed at people with a technical profile (programming, infrastructure, etc.) or at a general audience, and whether it requires prior knowledge of Drupal (site building, theming, development, etc.).</p>
<p><strong>MULTIPLE SESSIONS/WORKSHOPS PROPOSED BY ONE PERSON</strong><br>Every proposal is evaluated on its content, regardless of how many sessions each person submits. If several sessions or workshops by the same person are accepted, we will ask whether they can prepare all of them. If they can, they may present everything accepted. If not, they must choose, up to a maximum of 2 talks and/or workshops.<br>Proposals that follow the <a href="/en/guide-speakers">Guide for Speakers</a> will be valued positively.</p>
<p><strong>SELECTION PANEL</strong><br>Sessions will be reviewed by a panel of people with experience organizing and taking part in Drupal and other technology events:</p>
<ul><li>[TBD: name and drupal.org profile]</li><li>[TBD: name and drupal.org profile]</li><li>[TBD: name and drupal.org profile]</li></ul>
<p><strong>SELECTION TIMELINE</strong><br>The panel will review sessions from [TBD: date] to [TBD: date]. During the week of [TBD: date] we will email every speaker to let them know whether their session has been accepted.</p>
<p><strong>Note:</strong> The Spanish Drupal Association reserves the right to include, rearrange or modify the proposed sessions once the submission period has ended, always with the aim of ensuring the best possible experience for the community, enriching the diversity of proposals and ensuring the event runs smoothly.</p>
HTML,
    'es' => <<<'HTML'
<blockquote><p class="p--text-bigger">FECHA LÍMITE DE PRESENTACIÓN DE SESIONES: [PENDIENTE: DD de mes de 2027]</p></blockquote>
<p><strong>Los criterios de selección se basan en los siguientes parámetros:</strong></p>
<p><strong>VERSIÓN DE DRUPAL</strong><br>Tendrán prioridad los temas relacionados con las versiones actuales de Drupal: Drupal 11, Drupal 12 y Drupal CMS. Las sesiones sobre versiones anteriores solo se tendrán en cuenta si tratan sobre actualizaciones o migraciones.</p>
<p><strong>TEMÁTICAS PROPUESTAS</strong></p>
<ul class="ul--pills--inline"><li>Development</li><li>Testing</li><li>DevOps / Sistemas</li><li>Front-end / Theming</li><li>Site Building</li><li>Drupal CMS / Recipes</li><li>IA</li><li>Accesibilidad</li><li>Rendimiento</li><li>Contribución / Mentoring</li><li>Gestión de proyectos / Metodologías de trabajo</li><li>Business</li><li>Otros</li></ul>
<p><strong>IDIOMA</strong><br>Drupal Developer Days es un evento internacional, por lo que todas las sesiones deben impartirse en inglés.</p>
<p><strong>CONOCIMIENTOS REQUERIDOS</strong><br>De cada sesión se valorará si está dirigida a personas con un perfil técnico (programación, sistemas, etc.) o a cualquier público, y si requiere conocimientos previos de Drupal (site building, theming, desarrollo, etc.).</p>
<p><strong>VARIAS SESIONES/TALLERES PROPUESTOS POR UNA PERSONA</strong><br>Cada propuesta se valorará por su contenido, independientemente del número de sesiones que presente cada persona. Si se aceptan varias sesiones o talleres de una misma persona, se le preguntará si puede preparar todo el contenido. En caso afirmativo, podrá impartir todo lo aceptado; si no, tendrá que elegir, con un máximo de 2 charlas y/o talleres.<br>Se valorarán positivamente las propuestas que sigan la <a href="/es/guia-para-ponentes">Guía para ponentes</a>.</p>
<p><strong>PANEL DE SELECCIÓN</strong><br>Las sesiones las evaluará un grupo de personas con experiencia en la organización y participación en eventos de Drupal y otras tecnologías:</p>
<ul><li>[PENDIENTE: nombre y perfil de drupal.org]</li><li>[PENDIENTE: nombre y perfil de drupal.org]</li><li>[PENDIENTE: nombre y perfil de drupal.org]</li></ul>
<p><strong>PLAZOS DE SELECCIÓN</strong><br>El panel evaluará las sesiones del [PENDIENTE: fecha] al [PENDIENTE: fecha]. Durante la semana del [PENDIENTE: fecha] se enviará un correo a cada ponente indicando si su sesión ha sido aceptada.</p>
<p><strong>Nota:</strong> La Asociación Española de Drupal se reserva el derecho de incluir, reorganizar o modificar las sesiones propuestas una vez finalizado el plazo de presentación, siempre con el objetivo de garantizar la mejor experiencia posible para la comunidad, enriquecer la diversidad de las propuestas y asegurar el buen desarrollo del evento.</p>
HTML,
  ];

  $node = \Drupal::entityTypeManager()->getStorage('node')->load(3);
  if (!$node instanceof ContentEntityInterface) {
    return 'Node 3 not found. Nothing to do.';
  }

  foreach ($bodies as $langcode => $value) {
    if (!$node->hasTranslation($langcode)) {
      continue;
    }
    $node->getTranslation($langcode)->set('body', [
      'value' => str_replace("\n", '', $value),
      'format' => 'full_html',
    ]);
  }

  $node->setNewRevision(TRUE);
  $node->setRevisionLogMessage('Issue #14: Review selection criteria for Drupal Dev Days 2027.');
  $node->setRevisionCreationTime(\Drupal::time()->getRequestTime());
  $node->save();

  return 'Updated "Selection criteria for talks" (node 3).';
}

/**
 * Update "Guide for Speakers" (node 6) for Drupal Dev Days 2027.
 *
 * Values marked as [TBD] are pending decisions from the organization.
 */
function custom_general_features_update_11003(): string {
  // New field_text values, keyed by paragraph ID and language.
  $texts = [
    // Intro.
    37 => [
      'en' => '<p><strong>Here are some tips (some of them well known) to make sure nothing gets in the way of your talk and the content can really shine:</strong></p>',
    ],
    // Talks format.
    32 => [
      'en' => '<ul><li>Standard talks last 35 minutes, 40 at most, to explain and develop the topic. A volunteer will show you two signs: one when 10 minutes are left and another when 5 minutes are left.</li><li>After the talk, there are 5 to 10 minutes for questions from the audience.</li></ul>',
      'es' => '<ul><li>Las charlas estándar son las que hemos visto habitualmente en otras ediciones. La persona ponente dispone de 35 minutos, 40 como máximo, para explicar y desarrollar el tema de la charla. Una persona voluntaria te mostrará dos avisos, uno cuando queden 10 minutos y otro cuando queden 5 minutos.</li><li>Una vez terminada la exposición, pasamos al turno de preguntas. Se dispone de 5 a 10 minutos para responder a las preguntas planteadas por las personas asistentes a la charla.</li></ul>',
    ],
    // Time management.
    35 => [
      'en' => '<ul><li>The secret to a great talk is practice. It is important to manage your time so that the session fits within the allotted duration. A volunteer will let you know when 10 and 5 minutes are left.</li><li>Don\'t use up all your time: questions are one of the most important parts of the session. Leave time for them, as they will likely touch on points from your talk. This will enrich your presentation and win over the audience.</li><li>It\'s better to go slowly and cover less than to try to cover everything at full speed, like a Roadrunner. Less is more.</li></ul>',
      'es' => '<ul><li>El secreto para que una charla sea redonda es practicar una y otra vez. Es importante que controles los tiempos y la sesión se ajuste a la duración marcada. Una persona voluntaria te avisará cuando falten 10 y 5 minutos.</li><li>Es importante que no agotes el tiempo, ya que las preguntas son una de las partes más importantes de la sesión. Deja tiempo para esta parte en la que, muy seguramente, tocarás puntos de tu charla. Con ello conseguirás enriquecer tu intervención y ganarte al público.</li><li>Mejor ir despacio y contar menos que querer abarcar todo y ser un “Correcaminos”. Menos es más.</li></ul>',
    ],
    // Style and design of slides.
    36 => [
      'en' => '<ul><li>The organizing team recommends keeping the event\'s visual style. You can use this template: [TBD: Drupal Developer Days 2027 slide template link].</li><li>Keep it to eight lines of text per slide at most. Two readable slides are better than one that nobody can read.</li><li>Each line should have a maximum of 30 characters.</li><li>Use a font size of 28 points or larger, and be generous with line spacing.</li><li>Use few words, but choose them carefully for their meaning; this will make them easy to read and memorable for the audience.</li><li>What matters is not the slides, but you and everything you bring to the audience. Slides are a tool, not the talk!</li><li>If the content requires attention due to its complexity, divide it into sections and use diagrams. This way, you can expand or shorten your presentation on specific topics you consider relevant.</li><li>Avoid using UPPERCASE letters, as they make reading difficult, take up space, and are not attractive to your listeners. It\'s better to use bold or italics, but sparingly. We also do not recommend underlining.</li><li>The projection will be in 16:9 format (1920×1080 pixels).</li></ul>',
      'es' => '<ul><li>La recomendación del equipo organizador es mantener la línea gráfica del evento. Para ello ponemos a vuestra disposición la siguiente plantilla: [PENDIENTE: enlace a la plantilla de Drupal Developer Days 2027].</li><li>Limita a ocho las líneas de texto por diapositiva (mejor usar dos diapositivas que una en la que no se pueda leer nada).</li><li>Cada línea debe tener un máximo de 30 caracteres.</li><li>Utiliza un tamaño de 28 puntos, o más, y no te cortes con el interlineado, que sea generoso.</li><li>Emplea pocas palabras, pero con solera en significado, así serán fáciles de leer y se quedarán grabadas en la audiencia.</li><li>Lo importante no son las diapositivas, sino la persona ponente y todo lo que vas a aportar. Las diapositivas son un recurso, ¡no son la charla!</li><li>Si el contenido requiere de atención, por su complejidad, divídelo en secciones, utiliza esquemas, de esta forma podrás ampliar o recortar tu exposición con determinados temas que consideres que son relevantes.</li><li>Evita el uso de MAYÚSCULAS, complican la lectura, ocupan espacio y no resultan atractivas para quien te está escuchando. Es mejor que apuestes por el empleo de negrita o cursiva… pero sin abusar. Tampoco te recomendamos el subrayado.</li><li>La proyección se realizará en formato 16:9 (1920×1080 píxeles).</li></ul>',
    ],
  ];

  $node = \Drupal::entityTypeManager()->getStorage('node')->load(6);
  if (!$node instanceof ContentEntityInterface) {
    return 'Node 6 not found. Nothing to do.';
  }

  // Walk the paragraph tree from the node so the changes are saved as new
  // paragraph revisions referenced by the new node revision. Ancestors of a
  // changed paragraph must be flagged too, or they will not be re-saved.
  $update = function (ContentEntityInterface $entity) use (&$update, $texts): bool {
    $changed = FALSE;
    foreach (['field_sections', 'field_subsections'] as $field_name) {
      if (!$entity->hasField($field_name)) {
        continue;
      }
      foreach ($entity->get($field_name)->referencedEntities() as $paragraph) {
        $paragraph_changed = FALSE;
        foreach ($texts[$paragraph->id()] ?? [] as $langcode => $value) {
          if ($paragraph->hasTranslation($langcode)) {
            $paragraph->getTranslation($langcode)->set('field_text', [
              'value' => $value,
              'format' => $paragraph->get('field_text')->format,
            ]);
            $paragraph_changed = TRUE;
          }
        }
        if ($update($paragraph) || $paragraph_changed) {
          $paragraph->setNeedsSave(TRUE);
          $changed = TRUE;
        }
      }
    }
    return $changed;
  };

  if (!$update($node)) {
    return 'No paragraphs to update in node 6.';
  }

  $node->setNewRevision(TRUE);
  $node->setRevisionLogMessage('Issue #14: Review guide for speakers for Drupal Dev Days 2027.');
  $node->setRevisionCreationTime(\Drupal::time()->getRequestTime());
  $node->save();

  return 'Updated "Guide for Speakers" (node 6).';
}
