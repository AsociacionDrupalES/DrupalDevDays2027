{#
/**
 * @file
 * Session Schedule Card component.
 *
 * @param {string} title - The title of the time slot group
 * @param {array} items - Array of session items to display
 * @param {object} options - Grid display options
 */
#}

{%
  set classes = [
    'session-schedule-slot',
    'session-schedule-slot--' ~ options.alignment|default('horizontal'),
  ]
%}

<div {{ attributes.addClass(classes) }}>
  {% if title %}
    {% set title_text = title|render|striptags|trim %}
    {% if title_text matches '/^\\d{1,2}:\\d{2}\\s?[ap]m$/i' %}
      {% set title = title_text|date('H:i', false) %}
    {% endif %}
    <div class="session-schedule-slot__title">
      <h3>{{ title }}</h3>
    </div>
  {% endif %}
  <div class="session-schedule-slot__content">{{ items }}</div>
</div>
