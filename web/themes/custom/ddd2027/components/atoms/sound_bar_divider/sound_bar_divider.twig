{#
/**
 * @file
 * Sound bar divider component.
 *
 * Barras estilo ecualizador, divisor de sección insignia de la marca.
 * Traducción fiel de `SoundBarDivider.jsx` del design system: 24 barras
 * con alturas relativas precalculadas (mismo array exacto que el
 * original, no se recalcula la fórmula seno/coseno en Twig).
 *
 * @param {string} color - Color de fondo de las barras.
 * @param {number} height - Alto máximo del contenedor, en px.
 */
#}
{% set bar_heights = [
  0.3, 0.738, 0.937, 0.791, 0.343, 0.267, 0.678, 0.839, 0.663, 0.283,
  0.757, 0.988, 0.867, 0.441, 0.404, 0.679, 0.712, 0.546, 0.214, 0.719,
  0.981, 0.892, 0.497, 0.512
] %}
<div
  {{ attributes.addClass('sound-bar-divider') }}
  style="--sound-bar-color: {{ color|default('var(--color--accent)') }}; --sound-bar-height: {{ height|default(40) }}px;"
>
  {% for bar_height in bar_heights %}
    <div class="sound-bar-divider__bar" style="height: {{ (bar_height * 100)|round(1) }}%;"></div>
  {% endfor %}
</div>
